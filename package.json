{
  "name": "salatic",
  "version": "1.0.0",
  "private": true,
  "description": "Fast in-browser file converter and editor served by Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev",
    "test:e2e": "node tests/e2e/run.mjs",
    "check": "npm run build && npm run test && npm run test:e2e",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "fflate": "^0.8.3",
    "harfbuzzjs": "1.6.4",
    "libheif-js": "1.23.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "7.0.0",
    "utif2": "4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@docx-editor.dev/fonts": "2.34.0",
    "@docx-editor.dev/fonts-cjk": "2.34.0",
    "@expo-google-fonts/noto-emoji": "0.4.8",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "@types/node": "^22.20.5",
    "dejavu-fonts-ttf": "2.37.3",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
